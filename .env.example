HOST=0.0.0.0
PORT=1337
# Public base URL of this CMS (also drives the admin Secure-cookie default)
API_URL=http://localhost:1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
# Strapi secrets + ERP TOTP secrets at rest
ENCRYPTION_KEY=tobemodified

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# DATABASE_URL is used only when it is a real postgres:// URL; otherwise the
# discrete vars below are used.
DATABASE_CLIENT=postgres
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=vq_cms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false

# ── Admin session cookie (VAPT — missing Secure flag) ──────────────────────
# SET ADMIN_COOKIE_SECURE=true IN EVERY HTTPS ENVIRONMENT (uat, staging, prod).
# Unset → inferred from API_URL/APP_URL/PUBLIC_URL (https → on), else NODE_ENV.
# ADMIN_COOKIE_SECURE=true
# ADMIN_COOKIE_SAMESITE=strict

# ── Reverse proxy ──────────────────────────────────────────────────────────
# true wherever nginx / a load balancer terminates TLS in front of node. The
# proxy must send X-Forwarded-Proto and X-Forwarded-For. Never enable it if
# node is also reachable directly.
# IS_PROXIED=true
# HTTPS_REDIRECT=false            # escape hatch for the production HTTP→HTTPS redirect

# ── CORS (VAPT #16) ────────────────────────────────────────────────────────
# Comma-separated origins (scheme + host + port, no trailing slash). Localhost
# dev origins are added automatically outside production. Empty in production
# = block all cross-origin requests.
CORS_ORIGINS=

# Vite dev-server allowed hosts for the admin panel (comma-separated)
# ALLOWHOST=cms.example.com,uat-cms.example.com

# ── Admin panel ────────────────────────────────────────────────────────────
FLAG_PROMOTE_EE=false
# ADMIN_ALERT_EMAIL=security@example.com   # recipient of ERP security alerts

# ── Lead PII encryption at rest (AES-256-GCM) ──────────────────────────────
# Generate with: openssl rand -base64 32
# REQUIRED for form submissions. Losing or changing it makes stored lead PII
# unreadable — back it up and keep it identical across environments sharing a DB.
LEADS_ENCRYPTION_KEY=tobemodified

# ── Public form encryption + CSRF (RSA keypairs, PEM, \n-escaped or multi-line) ─
# TOKEN_PUBLIC_FORM / TOKEN_PRIVATE_FORM: frontend encrypts PII with the public
# key, the CMS decrypts with the private key.
# TOKEN_PUBLIC / TOKEN_PRIVATE: signs the single-use CSRF token (RS256).
TOKEN_PUBLIC_FORM=
TOKEN_PRIVATE_FORM=
TOKEN_PUBLIC=
TOKEN_PRIVATE=
# Fallback notification recipients when Contact Page → emails is empty
# FORM_NOTIFY_EMAIL=leads@example.com
# Bootstrap grants the Public role ONLY csrf-token + contact-form-submission
# (src/lifecycle/public-access.js). false = manage these in the admin panel.
# PUBLIC_FORM_AUTOGRANT=true
# Media-library folder id for files uploaded through forms
# FORM_UPLOAD_FOLDER_ID=

# ── Email ──────────────────────────────────────────────────────────────────
# ENABLE_EMAIL=ON actually sends mail. SMTP_HOST switches the provider to
# nodemailer (on-demand: `npm run deps:install -- smtp`).
ENABLE_EMAIL=OFF
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=no-reply@example.com
# EMAIL_REPLYTO=no-reply@example.com
# INTERNAL_EMAIL=                 # BCC'd on every notification

# ── JSON snapshots (uploads/data/*.json) ───────────────────────────────────
# On admin edits the worker fetches the content type from the REST API and
# writes it to public/uploads/data (or the bucket). Routes per content type:
# src/workers/json-routes.js. Token: Settings → API Tokens (read-only).
STRAPI_API_BASE=http://localhost:1337
STRAPI_API_TOKEN=

# ── Meilisearch (on-demand: `npm run deps:install -- meili`) ───────────────
# MEILI_ENABLE=true
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_API_KEY=

# ── Cron + frontend revalidate webhook ─────────────────────────────────────
# CRON_ENABLED=true
# CACHE_SYNC_WEBHOOK_URL=https://www.example.com/api/revalidate
# REVALIDATE_SECRET_TOKEN=

# ── ERP session store ──────────────────────────────────────────────────────
# Database store is the default (takes priority over Redis).
# ERP_DB_STORE_ENABLED=true
# Redis (on-demand: `npm run deps:install -- redis`); set ERP_DB_STORE_ENABLED=false to use it
# ERP_REDIS_ENABLED=true
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Media storage — default is the self-hosted local library ───────────────
# Set ONE bucket to switch provider (GCS wins if both are set), then run
# `npm run deps:install` to fetch only that SDK.
# GCS_BUCKET=
# GCS_PROJECT_ID=
# GCS_KEY_FILE_PATH=/run/secrets/gcs-sa-key.json
# GCS_KEY_JSON={"type":"service_account",...}
# GCS_CDN_URL=
# GCS_ROOT_PATH=
# GCS_UNIFORM_ACCESS=true
# GCS_SIGNED_URL_EXPIRES=900
#
# AWS_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_CDN_URL=
# AWS_ROOT_PATH=
# AWS_ACL=public-read
# AWS_SIGNED_URL_EXPIRES=900
# APP_URL=https://api.example.com     # also used for bucket CORS origins
# PUBLIC_URL=https://cdn.example.com
