      },
      {
        "label": "Credit Solutions / Structured Finance",
        "value": "Credit Solutions / Structured Finance"
      },
      {
        "label": "Asset Management",
        "value": "Asset Management"
      },
      {
        "label": "Careers & Recruitment",
        "value": "Careers & Recruitment"
      },
      {
        "label": "Media & Press Inquiries",
        "value": "Media & Press Inquiries"
      },
      {
        "label": "General Inquiry",
        "value": "General Inquiry"
      }
