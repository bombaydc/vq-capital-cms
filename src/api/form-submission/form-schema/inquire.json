{
  "name": {
    "name": "name",
    "type": "text",
    "title": "Name",
    "default": null,
    "position": 1,
    "required": true,
    "maxLength": 100,
    "minLength": 2,
    "validation": {
      "pattern": [
        {
          "value": "^[a-zA-Z\\s\\-\\.']+$",
          "message": "Name must contain only letters, spaces, hyphens, apostrophes and periods"
        }
      ]
    },
    "placeholder": ""
  },
  "countrycode": {
    "name": "countrycode",
    "type": "country_select",
    "title": "Country Code",
    "default": "+91",
    "multiple": false,
    "position": 2,
    "required": true,
    "searchable": true,
    "placeholder": ""
  },
  "mobile": {
    "name": "mobile",
    "type": "tel",
    "title": "Mobile Number",
    "default": null,
    "position": 3,
    "required": true,
    "placeholder": "",
    "defaultCountry": "91",
    "defaultMobileLength": 10
  },
  "email": {
    "name": "email",
    "type": "email",
    "title": "Email",
    "default": null,
    "position": 4,
    "required": true,
    "placeholder": ""
