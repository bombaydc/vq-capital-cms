{
  "kind": "collectionType",
  "collectionName": "insights",
  "info": {
    "singularName": "insight",
    "pluralName": "insights",
    "displayName": "Insight",
    "description": "Research papers, publications and thought leadership, with their article pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Research papers",
        "Publications",
        "Thought leadership"
      ]
    },
    "label": {
      "type": "string"
    },
    "label_value": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "buttons": {
      "type": "component",
      "component": "common.button",
      "repeatable": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "author": {
      "type": "string"
    },
    "body": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultHtml"
      }
    },
    "source_button": {
      "type": "component",
      "component": "common.button",
      "repeatable": false
    },
    "disclaimer": {
      "type": "text"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
